{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build and Run C++17",
            "type": "shell",
            "command": "/usr/bin/g++-13",
            "args": [
                "-std=c++17",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "&&",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "focus": true
            },
            "problemMatcher": ["$gcc"]
        }
    ]
}